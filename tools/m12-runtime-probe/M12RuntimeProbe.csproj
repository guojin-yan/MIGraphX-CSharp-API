<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>M12RuntimeProbe</AssemblyName>
    <RootNamespace>M12RuntimeProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <M12PackageVersion Condition="'$(M12PackageVersion)' == ''">0.0.0</M12PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JYPPX.ROCm.MIGraphX.CSharp.API" Version="[$(M12PackageVersion)]" />
  </ItemGroup>
</Project>
