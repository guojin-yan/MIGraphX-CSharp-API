<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>M11RuntimeProbe</AssemblyName>
    <RootNamespace>M11RuntimeProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <M11PackageVersion Condition="'$(M11PackageVersion)' == ''">0.9.0-rc.3</M11PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JYPPX.ROCm.MIGraphX.CSharp.API" Version="[$(M11PackageVersion)]" />
    <PackageReference Include="JYPPX.ROCm.MIGraphX.CSharp.API.HIP.Interop" Version="[$(M11PackageVersion)]" />
    <PackageReference Include="JYPPX.ROCm.HIP.CSharp.API" Version="[0.9.1]" />
  </ItemGroup>
</Project>
