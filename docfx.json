{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/JYPPX.ROCm.MIGraphX.CSharp.API/JYPPX.ROCm.MIGraphX.CSharp.API.csproj"
          ],
          "src": "."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/toc.yml",
          "api/*.yml"
        ],
        "src": "docs"
      },
      {
        "files": [
          "api/*.yml"
        ],
        "src": "."
      }
    ],
    "dest": "artifacts/docs",
    "globalMetadata": {
      "_appName": "MIGraphXSharp",
      "_appTitle": "MIGraphXSharp Documentation",
      "_gitContribute": {
        "repo": "https://github.com/guojin-yan/MIGraphX-CSharp-API"
      }
    },
    "template": [
      "default",
      "modern"
    ],
    "sitemap": {
      "baseUrl": "https://guojin-yan.github.io/MIGraphX-CSharp-API/"
    }
  }
}
