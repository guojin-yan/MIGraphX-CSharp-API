<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(JYPPXManagedTargetFrameworks)</TargetFrameworks>
    <AssemblyName>JYPPX.ROCm.MIGraphX.CSharp.API</AssemblyName>
    <RootNamespace>JYPPX.ROCm.MIGraphXSharp</RootNamespace>
    <PackageId>$(MIGraphXSharpPackageId)</PackageId>
    <Title>MIGraphX CSharp API</Title>
    <Description>Managed bindings and resource wrappers for the AMD MIGraphX C API. Native MIGraphX and ROCm are installed separately.</Description>
    <PackageTags>AMD;ROCm;MIGraphX;interop;inference</PackageTags>
    <PackageProjectUrl>$(MIGraphXSharpRepositoryUrl)</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Managed MIGraphX bindings with explicit ownership, ONNX workflows, typed attributes, graph and cache APIs. Includes standalone YOLO26 and PP-OCRv6 source samples. Install the matching AMD system runtime separately and review the documented platform and experimental API limitations.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <DefineConstants>$(DefineConstants);MIGRAPHX_LIBRARYIMPORT_PATH</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <DefineConstants>$(DefineConstants);MIGRAPHX_DLLIMPORT_PATH</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netcoreapp3.1'))">
    <DefineConstants>$(DefineConstants);MIGRAPHX_NATIVE_LIBRARY_PATH</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\docs\package\README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
