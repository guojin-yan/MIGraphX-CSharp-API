<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>JYPPX.ROCm.MIGraphX.CSharp.API.Runtime.linux-x64</PackageId>
    <PackageVersion>7.2.1</PackageVersion>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <Target Name="RejectDeferredRuntimePack" BeforeTargets="GenerateNuspec">
    <Error Code="MIGRAPHX1001"
           Text="Runtime packing is fail-closed while M7 is runtime-deferred; no command-line property can authorize a package." />
  </Target>
</Project>
