      {
        "candidate": "self-contained MIGraphX runtime",
        "reason": "It duplicates HIP/HSA/COMGR paths and still exceeds the size gate."
      },
      {
        "candidate": "shared unversioned ROCm runtime",
        "reason": "M7 cannot create a new shared package without independent package/API/version governance."
      }
    ]
  },
