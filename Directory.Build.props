<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <MIGraphXWorkspaceRoot Condition="'$(MIGraphXWorkspaceRoot)' == '' and '$(MIGRAPHX_WORKSPACE_ROOT)' != ''">$(MIGRAPHX_WORKSPACE_ROOT)</MIGraphXWorkspaceRoot>
    <MIGraphXWorkspaceRoot Condition="'$(MIGraphXWorkspaceRoot)' == ''">$(RepositoryRoot)..\MIGraphXSharp.Workspace</MIGraphXWorkspaceRoot>
    <MIGraphXWorkspaceRoot>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MIGraphXWorkspaceRoot)'))))</MIGraphXWorkspaceRoot>
    <MIGraphXArtifactsRoot>$(MIGraphXWorkspaceRoot)artifacts\</MIGraphXArtifactsRoot>
    <JYPPXManagedTargetFrameworks>net46;net461;net462;net47;net471;net472;net48;net481;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</JYPPXManagedTargetFrameworks>
    <MIGraphXSharpPackageId>JYPPX.ROCm.MIGraphX.CSharp.API</MIGraphXSharpPackageId>
    <MIGraphXSharpVersion Condition="'$(MIGraphXSharpVersion)' == ''">0.0.0</MIGraphXSharpVersion>
    <MIGraphXSharpNumericVersion>$([System.Text.RegularExpressions.Regex]::Match('$(MIGraphXSharpVersion)', '^\d+\.\d+\.\d+').Value)</MIGraphXSharpNumericVersion>
    <MIGraphXSharpRepositoryUrl>https://github.com/guojin-yan/MIGraphX-CSharp-API</MIGraphXSharpRepositoryUrl>
    <Authors>Guojin Yan</Authors>
    <Company>JYPPX</Company>
    <Copyright>Copyright 2026 Guojin Yan</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Version>$(MIGraphXSharpVersion)</Version>
    <PackageVersion>$(MIGraphXSharpVersion)</PackageVersion>
    <AssemblyVersion>$(MIGraphXSharpNumericVersion).0</AssemblyVersion>
    <FileVersion>$(MIGraphXSharpNumericVersion).0</FileVersion>
    <MIGraphXSharpInformationalVersion>$(MIGraphXSharpVersion)</MIGraphXSharpInformationalVersion>
    <MIGraphXSharpInformationalVersion Condition="'$(RepositoryCommit)' != ''">$(MIGraphXSharpVersion)+$(RepositoryCommit)</MIGraphXSharpInformationalVersion>
    <MIGraphXSharpRepositoryCommitValid Condition="'$(RepositoryCommit)' != ''">$([System.Text.RegularExpressions.Regex]::IsMatch('$(RepositoryCommit)', '^[a-f0-9]{40}$'))</MIGraphXSharpRepositoryCommitValid>
    <InformationalVersion>$(MIGraphXSharpInformationalVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryUrl>$(MIGraphXSharpRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PathMap>$(RepositoryRoot)=/_/,$(MIGraphXWorkspaceRoot)=/_/workspace/</PathMap>
    <BaseOutputPath>$(MIGraphXArtifactsRoot)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MIGraphXArtifactsRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <RestorePackagesPath>$(MIGraphXArtifactsRoot)packages\restore</RestorePackagesPath>
    <VSTestResultsDirectory>$(MIGraphXWorkspaceRoot)test-results\$(MSBuildProjectName)</VSTestResultsDirectory>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <HipSharpRepositoryRoot Condition="'$(HipSharpRepositoryRoot)' == '' and '$(HIPSHARP_REPOSITORY_ROOT)' != ''">$(HIPSHARP_REPOSITORY_ROOT)</HipSharpRepositoryRoot>
    <HipSharpRepositoryRoot Condition="'$(HipSharpRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\..\HIP-CSharp-API\HIP-CSharp-API\</HipSharpRepositoryRoot>
    <HipSharpPackageVersion Condition="'$(HipSharpPackageVersion)' == ''">0.10.0</HipSharpPackageVersion>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Yolo26' or '$(MSBuildProjectName)' == 'PaddleOcr' or '$(MSBuildProjectName)' == 'Vision.SampleTests'">
    <!-- ImageSharp 3.1 advisories remain visible for these local-image examples.
         The published core/adapter packages do not depend on ImageSharp and are audited separately. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
