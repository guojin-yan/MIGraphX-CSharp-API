<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <JYPPXManagedTargetFrameworks>net46;net461;net462;net47;net471;net472;net48;net481;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</JYPPXManagedTargetFrameworks>
    <MIGraphXSharpPackageId>JYPPX.ROCm.MIGraphX.CSharp.API</MIGraphXSharpPackageId>
    <MIGraphXSharpVersion Condition="'$(MIGraphXSharpVersion)' == ''">0.0.0</MIGraphXSharpVersion>
    <MIGraphXSharpRepositoryUrl>https://github.com/guojin-yan/MIGraphX-CSharp-API</MIGraphXSharpRepositoryUrl>
    <Authors>JYPPX</Authors>
    <Company>JYPPX</Company>
    <Version>$(MIGraphXSharpVersion)</Version>
    <PackageVersion>$(MIGraphXSharpVersion)</PackageVersion>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryUrl>$(MIGraphXSharpRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PathMap>$(RepositoryRoot)=/_/</PathMap>
    <BaseOutputPath>$(RepositoryRoot)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepositoryRoot)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <RestorePackagesPath>$(RepositoryRoot)artifacts\packages\restore</RestorePackagesPath>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
