<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <MIGraphXConsumerVersion Condition="'$(MIGraphXConsumerVersion)' == ''">$(MIGraphXSharpVersion)</MIGraphXConsumerVersion>
    <MIGraphXRuntimePlatform Condition="'$(MIGraphXRuntimePlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MIGraphXRuntimePlatform>
    <MIGraphXRuntimePlatform Condition="'$(MIGraphXRuntimePlatform)' == ''">ubuntu.24.04-x64</MIGraphXRuntimePlatform>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JYPPX.ROCm.MIGraphX.CSharp.API" Version="[$(MIGraphXConsumerVersion)]" />
    <PackageReference Include="JYPPX.ROCm.MIGraphX.CSharp.API.Runtime.$(MIGraphXRuntimePlatform)" Version="[$(MIGraphXConsumerVersion)]" />
  </ItemGroup>
</Project>
