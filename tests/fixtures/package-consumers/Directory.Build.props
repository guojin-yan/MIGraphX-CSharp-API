<Project>
  <Import Project="../../../Directory.Build.props" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ConsumerFrameworkDirectory>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</ConsumerFrameworkDirectory>
    <BaseOutputPath>$(MIGraphXArtifactsRoot)package-consumers\$(ConsumerFrameworkDirectory)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MIGraphXArtifactsRoot)package-consumers\$(ConsumerFrameworkDirectory)\obj\</BaseIntermediateOutputPath>
    <RestorePackagesPath>$(MIGraphXArtifactsRoot)packages\consumers</RestorePackagesPath>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <MIGraphXConsumerVersion Condition="'$(MIGraphXConsumerVersion)' == ''">0.0.0</MIGraphXConsumerVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
