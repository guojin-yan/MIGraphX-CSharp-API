{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/MIGraphX-CSharp-API/schemas/binding-classifications.schema.json",
  "title": "MIGraphXSharp binding classification manifest",
  "type": "object",
  "required": ["$schema", "schemaVersion", "manifestVersion", "validationLevel"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "manifestVersion": { "const": "1.0.0" },
