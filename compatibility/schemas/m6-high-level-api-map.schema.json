{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guojin-yan.github.io/MIGraphX-CSharp-API/schemas/m6-high-level-api-map.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "stage", "sourceMap", "sourceHeaderSha256", "evidenceBoundary", "counts", "mappings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "stage": { "const": "M6" },
    "counts": { "type": "object", "required": ["inventory", "supported", "planned", "unsupported"] },
    "mappings": { "type": "array", "minItems": 1 }
  }
}
